{
	admin off
}

# xpaze.es (Cloudflare Tunnel → :5190). Web v2, demo y app de /ruta/a/xpaze/dist.
:5190 {
	# Todo público. La IA tiene límites por IP y por día en server/psicologa.js.

	@demoai path /demo/api/psicologa /demo/api/voz/sesion
	handle @demoai {
		uri strip_prefix /demo
		reverse_proxy 127.0.0.1:5193 {
			flush_interval -1
		}
	}

	# IA de la app (pública, con límites por IP y día en server/psicologa.js)
	@appai path /app/api/espacio /app/api/psicologa /app/api/explicar /app/api/salud /app/api/salud/* /app/api/voz/sesion
	handle @appai {
		uri strip_prefix /app
		reverse_proxy 127.0.0.1:5193 {
			flush_interval -1
		}
	}

	handle {
		root * /ruta/a/xpaze/dist
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /app/sw.js Cache-Control "no-cache"
		header /app/manifest.webmanifest Content-Type "application/manifest+json"
		file_server
	}
}
